# Copie ce fichier en .env et remplis ce dont tu as besoin.

# Comment Ultron t'appelle (optionnel)
USER_NAME=

# Trello : clé et jeton personnels (voir README, « Brancher Trello »)
TRELLO_KEY=
TRELLO_TOKEN=
# Limiter à certains tableaux, par nom, séparés par des virgules. Vide = tous les tableaux ouverts.
TRELLO_BOARDS=

# Cerveau : la CLI Claude Code, avec ton compte Claude
# Modèle : haiku (le plus rapide à l'oral), sonnet, opus. Vide = celui par défaut de ton compte.
CLAUDE_MODEL=haiku
# Chemin de la commande si elle n'est pas dans le PATH
CLAUDE_BIN=claude

# Divers
PORT=4242
# Sessions Claude Code affichées : celles actives depuis moins de N heures
SESSION_HOURS=72
# Expérimental : garder un seul process claude ouvert et répondre en flux (parole dès la 1re phrase).
# Plus rapide, mais à valider chez toi. Vide ou 0 = mode classique (un claude -p par question).
ULTRON_STREAM=0

# Voix de synthèse externe (optionnelle). Vide = voix du navigateur (défaut).
# Ultron POST {text} vers cette URL et joue l'audio renvoyé (le texte sort donc de la machine).
ULTRON_TTS_URL=
ULTRON_TTS_KEY=
ULTRON_TTS_VOICE=

# Usage de l'abonnement (optionnel) : une commande qui imprime du JSON décrivant les fenêtres
# (ex. {"five_hour":{"utilization":0.4},"seven_day":{"used":72}}). Vide = section masquée.
ULTRON_USAGE_CMD=
